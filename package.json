{
  "name": "emos.club",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "EMOS 媒体服务管理台 · 暗色数据台（React + TanStack + Cloudflare Workers）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "docs:api": "python3 scripts/gen-api-reference.py && python3 scripts/check-api-coverage.py"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-router": "^1.79.0",
    "parse-torrent-title": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wrangler": "^4.84.1"
  }
}
