{
  "name": "emos-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EMOS媒体管理系统",
  "author": "EMOS Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "build:worker": "npm run build && node build-worker.cjs",
