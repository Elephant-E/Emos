    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.2.6",
    "wrangler": "^4.84.1"
  }
}
