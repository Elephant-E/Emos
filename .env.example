# 留空 = 同域 /api（生产走 Worker 反代）
VITE_API_BASE=

# 1 = 使用内置假数据（无后端也能开发/评审）
VITE_MOCK=1

# 仅 vite dev 的代理目标，默认生产环境。
# https://test.emos.best 当前返回 530（Cloudflare 1016），公网 DNS 无 A 记录，暂不作默认值。
VITE_API_ORIGIN=https://emos.best

# 红包封面所用的独立临时上传服务，默认生产。
# VITE_TEMPORARY_ORIGIN=https://temporary.emos.best

# 登录页「群聊」链接；不配则用 https://t.me/emospg
# VITE_GROUP_URL=https://t.me/yourgroup
