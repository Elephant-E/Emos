# 留空 = 同域 /api（生产走 Worker 反代）
VITE_API_BASE=

# 1 = 使用内置假数据（无后端也能开发/评审）
VITE_MOCK=1

# 仅 vite dev 的代理目标。切测试环境就改成 https://test.emos.best
# （2026-11-11 实测该域名是 530 / Cloudflare 1016，公网 DNS 无 A 记录，暂时用生产）
VITE_API_ORIGIN=https://emos.best

# 红包封面走的独立临时上传服务，默认生产；测试环境要换就覆盖
# VITE_TEMPORARY_ORIGIN=https://temporary.emos.best
